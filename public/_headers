# script.google.com y script.googleusercontent.com en connect-src: el
# formulario de /resena/ habla con la web app de Apps Script, que contesta
# redirigiendo a googleusercontent.com (ver scripts/resenas-webapp/).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://player.vimeo.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://script.google.com https://script.googleusercontent.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Google rechazo el sitemap con "El sitemap es HTML", y el navegador lo
# renderizaba como texto corrido en vez del arbol XML -- las dos cosas son el
# mismo sintoma: llegaba con un Content-Type que se lee como HTML. Se fija
# explicito. Ojo: X-Content-Type-Options: nosniff (arriba) impide que el
# navegador lo adivine, asi que la cabecera tiene que estar bien de origen.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# La fuente propia no cambia: se puede cachear un ano entero
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Portafolio en PDF (scripts/portafolio-pdf/render.js --publicar). Se abre en
# el navegador y, al guardarlo, sale con nombre de archivo decente. Caché
# corta: el archivo se regenera con el mismo nombre. Sin la CSP general:
# su object-src 'none' le impide a Chrome abrir el PDF en su visor.
/portfolio/sports.pdf
  ! Content-Security-Policy
  Content-Disposition: inline; filename="NotMan-Portfolio-Sports.pdf"
  Cache-Control: public, max-age=3600
/portfolio/general.pdf
  ! Content-Security-Policy
  Content-Disposition: inline; filename="NotMan-Portfolio-General.pdf"
  Cache-Control: public, max-age=3600
