<?xml version="1.0" encoding="UTF-8"?>
<!-- Cinco URLs, sin build step que mantenga fechas. Se quitaron <lastmod>,
     <changefreq> y <priority> a proposito: Google ignora los dos ultimos por
     completo, y solo hace caso a lastmod si es fiable. Una fecha puesta a
     mano se queda vieja al primer cambio que se nos olvide, y una fecha
     mentirosa es peor que ninguna.
     /en/ se genera con scripts/build-en.js antes de cada deploy (no vive en
     el repo) -- pero como URL SI hace falta declararla aqui a mano, el
     sitemap no se genera solo. Los <xhtml:link hreflang> repiten en el
     sitemap la misma relacion que ya declaran los <link> en el <head> de
     cada pagina -- pertenecen en los dos sitios, no es redundante: el
     <head> es lo que ve un visitante/crawler que ya esta en la pagina, el
     sitemap es lo primero que Google lee, antes de visitar nada. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://notmanrivera.com/</loc>
    <xhtml:link rel="alternate" hreflang="es" href="https://notmanrivera.com/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://notmanrivera.com/en/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://notmanrivera.com/"/>
  </url>
  <url>
    <loc>https://notmanrivera.com/en/</loc>
    <xhtml:link rel="alternate" hreflang="es" href="https://notmanrivera.com/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://notmanrivera.com/en/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://notmanrivera.com/"/>
  </url>
  <!-- Casos de estudio (public/casos/): paginas propias, solo en español
       por ahora -- sin hreflang porque todavia no tienen contraparte en
       ingles (a diferencia de / y /en/, que si son traducciones exactas
       una de otra). -->
  <url>
    <loc>https://notmanrivera.com/casos/al-arabi-sc/</loc>
  </url>
  <url>
    <loc>https://notmanrivera.com/casos/mazatlan-fc/</loc>
  </url>
  <url>
    <loc>https://notmanrivera.com/casos/diseno-web/</loc>
  </url>
</urlset>
